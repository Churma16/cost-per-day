{
  "name": "cost-per-day",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "cra-template": "1.2.0",
    "date-fns": "^4.1.0",
    "i18next": "~22.5.0",
    "i18next-browser-languagedetector": "~7.0.0",
    "react": "^19.0.0",
    "react-datepicker": "^8.0.0",
    "react-day-picker": "^9.5.1",
    "react-dom": "^19.0.0",
    "react-i18next": "~12.3.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "set \"GENERATE_SOURCEMAP=false\" && react-scripts start",
    "server": "cd backend && air",
    "server:build": "cd backend && go run ./cmd/server",
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run server\" \"npm start\"",
    "build": "set \"GENERATE_SOURCEMAP=false\" && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^date-fns/locale$": "<rootDir>/node_modules/date-fns/locale.cjs",
      "^date-fns/locale/(.*)$": "<rootDir>/node_modules/date-fns/locale/$1.cjs",
      "^date-fns$": "<rootDir>/node_modules/date-fns/index.cjs",
      "^date-fns/(.*)$": "<rootDir>/node_modules/date-fns/$1.cjs",
      "^react-day-picker/dist/style.css$": "<rootDir>/node_modules/react-day-picker/src/style.css"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}
