# Backend Environment Configuration Example
PORT=8080
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_PATH=./data/cost-per-day.db

# Google-only OIDC authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Optional one-time upgrade mapping for databases that already contain legacy-owned data.
# Set this to the verified Google OIDC subject of the existing owner, deploy and sign in once,
# then it may be removed after the subject is permanently bound to the local "legacy" user.
LEGACY_OWNER_GOOGLE_SUB=

# Optional. Set this only when the backend should serve a compiled frontend.
# The production container sets STATIC_DIR=/app/web.
STATIC_DIR=
